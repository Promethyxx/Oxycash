// oxycash-rs - ui/settings.slint

import { I18n } from "i18n.slint";
import { Palette } from "palette.slint";

export struct ProfileItem {
    name: string,
    slug: string,
    active: bool,
    idx: int,
}

component Card inherits Rectangle {
    in property <string> title;
    border-radius: 12px;
    background: Palette.card;
    border-width: 1px;
    border-color: Palette.card-border;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Text {
            text: title;
            font-size: 14px + Palette.font-offset;
            font-weight: 600;
            color: Palette.text3;
        }
        @children
    }
}

component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <color>  bg-color:   Palette.card;
    in property <color>  text-color: Palette.text;
    in property <bool>   danger:     false;
    callback clicked;
    height: 36px;
    min-width: 60px;
    border-radius: 8px;
    background: danger ? transparent : bg-color;
    border-width: danger ? 1px : 0px;
    border-color: danger ? Palette.danger : transparent;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: label;
        font-size: 14px + Palette.font-offset;
        font-weight: 600;
        color: danger ? Palette.danger : text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> value;
    callback changed(bool);
    height: 36px;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: label;
            font-size: 14px + Palette.font-offset;
            color: Palette.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Switch
        Rectangle {
            width: 50px; height: 26px;
            border-radius: 13px;
            background: value ? Palette.teal : Palette.card-border;
            animate background { duration: 150ms; }
            TouchArea {
                clicked => {
                    value = !value;
                    root.changed(value);
                }
            }
            Rectangle {
                width: 20px; height: 20px;
                border-radius: 10px;
                background: white;
                x: value ? parent.width - self.width - 3px : 3px;
                y: (parent.height - self.height) / 2;
                animate x { duration: 150ms; }
            }
        }
    }
}

component InputField inherits Rectangle {
    in property <string>  label-text;
    in-out property <string> value;
    in property <bool>    is-password: false;
    in-out property <bool> show-password: false;
    height: 56px;
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Text {
            text: label-text;
            font-size: 14px + Palette.font-offset;
            color: Palette.text2;
        }
        HorizontalLayout {
            spacing: 4px;
            Rectangle {
                horizontal-stretch: 1;
                height: 34px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: Palette.card;
                if !is-password || show-password : TextInput {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text <=> root.value;
                    font-size: 15px + Palette.font-offset;
                    color: Palette.text;
                    vertical-alignment: center;
                }
                if is-password && !show-password : TextInput {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text <=> root.value;
                    font-size: 15px + Palette.font-offset;
                    color: Palette.text;
                    vertical-alignment: center;
                    input-type: password;
                }
            }
            if is-password : Rectangle {
                width: 34px; height: 34px; border-radius: 6px;
                border-width: 1px; border-color: Palette.card-border;
                TouchArea { clicked => { show-password = !show-password; } }
                Text {
                    text: show-password ? "🙈" : "👁";
                    font-size: 16px + Palette.font-offset;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
}

export component SettingsView inherits Flickable {
    viewport-width: self.width;

    in-out property <string> profile-name: "Default";
    in property <string> currency:     "CHF";
    in property <bool>   is-dark:      true;
    in property <string> dav-status:   "";

    in property <[ProfileItem]> profiles: [];

    // WebDAV1
    in-out property <string> dav-url:  "";
    in-out property <string> dav-user: "";
    in-out property <string> dav-pass: "";

    // WebDAV2
    in-out property <string> dav2-url:     "";
    in-out property <string> dav2-user:    "";
    in-out property <string> dav2-pass:    "";
    in-out property <bool>   dav2-enabled: false;
    in property <string>     dav2-status:  "";

    // Currency
    in-out property <string> currency-edit: "CHF";

    // Backup
    in-out property <bool>   backup-local:   true;
    in-out property <bool>   backup-webdav:  true;
    in-out property <string> data-dir-edit:  "";
    in property <string>     data-dir-display: "";
    in property <string>     backup-dir-display: "";

    callback toggle-theme;
    callback save-dav();
    callback test-dav();
    callback clear-dav();
    callback save-dav2();
    callback test-dav2();
    callback clear-dav2();
    callback save-currency();
    callback do-export();
    callback do-import();
    callback do-reset();
    callback switch-profile(int);
    callback delete-profile(int);
    callback add-profile(string);
    callback rename-profile(string);
    callback set-backup-local(bool);
    callback set-backup-webdav(bool);
    callback set-data-dir(string);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: I18n.cfg-title;
            font-size: 22px + Palette.font-offset;
            font-weight: 700;
            color: Palette.text;
        }

        // ── Profiles ─────────────────────────
        Card {
            title: I18n.cfg-profiles;

            for prof in profiles : Rectangle {
                height: 38px;
                border-radius: 8px;
                background: prof.active ? Palette.card : transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    Rectangle {
                        width: 8px; height: 8px; border-radius: 4px;
                        background: prof.active ? Palette.teal : transparent;
                        border-width: 1px; border-color: Palette.teal;
                        y: (parent.height - self.height) / 2;
                    }

                    // Nom : texte statique pour les profils inactifs,
                    // champ éditable pour le profil actif
                    if !prof.active : Text {
                        text: prof.name;
                        font-size: 14px + Palette.font-offset;
                        color: Palette.text2;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if prof.active : Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: rename-input.has-focus ? Palette.teal : transparent;
                        background: rename-input.has-focus ? Palette.card : transparent;
                        animate border-color { duration: 120ms; }
                        rename-input := TextInput {
                            x: 4px; width: parent.width - 8px; height: parent.height;
                            text <=> root.profile-name;
                            font-size: 14px + Palette.font-offset;
                            font-weight: 600;
                            color: Palette.text;
                            vertical-alignment: center;
                            accepted => {
                                if self.text != "" { root.rename-profile(self.text); }
                            }
                            changed has-focus => {
                                if !self.has-focus && self.text != "" && self.text != prof.name {
                                    root.rename-profile(self.text);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 44px; height: 26px; border-radius: 6px;
                        border-width: 1px;
                        border-color: prof.active ? Palette.teal : Palette.card-border;
                        TouchArea { clicked => { root.switch-profile(prof.idx); } }
                        Text {
                            text: prof.active ? "✓" : I18n.cfg-use;
                            font-size: 14px + Palette.font-offset;
                            color: prof.active ? Palette.teal : Palette.text2;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px; height: 24px; border-radius: 4px;
                        TouchArea { clicked => { root.delete-profile(prof.idx); } }
                        Text {
                            text: "x";
                            font-size: 14px + Palette.font-offset;
                            color: Palette.danger;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px; height: 36px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.card-border;
                    new-name-input := TextInput {
                        font-size: 14px + Palette.font-offset;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                }
                ActionBtn {
                    label: I18n.cfg-add-profile;
                    bg-color: Palette.teal; text-color: #1a1a1a;
                    clicked => {
                        root.add-profile(new-name-input.text);
                        new-name-input.text = "";
                    }
                }
            }
        }

        // ── Currency ─────────────────────────
        Card {
            title: I18n.cfg-currency;
            HorizontalLayout {
                spacing: 8px; height: 36px;
                Rectangle {
                    width: 80px; border-radius: 6px;
                    border-width: 1px; border-color: Palette.card-border;
                    TextInput {
                        text <=> root.currency-edit;
                        font-size: 15px + Palette.font-offset;
                        color: Palette.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                ActionBtn {
                    label: I18n.cfg-save;
                    bg-color: Palette.gold; text-color: #1a1a1a;
                    clicked => { root.save-currency(); }
                }
            }
        }

        // ── Theme ────────────────────────────
        Card {
            title: I18n.cfg-theme;
            Rectangle {
                height: 40px; border-radius: 8px;
                border-width: 1px; border-color: Palette.card-border;
                TouchArea { clicked => { root.toggle-theme(); } }
                HorizontalLayout {
                    padding-left: 12px; spacing: 8px;
                    Text { text: is-dark ? "🌙" : "☀️"; font-size: 20px + Palette.font-offset; vertical-alignment: center; }
                    Text {
                        text: is-dark ? I18n.cfg-dark-to-light : I18n.cfg-light-to-dark;
                        font-size: 15px + Palette.font-offset; font-weight: 600;
                        color: Palette.text; vertical-alignment: center;
                    }
                }
            }
        }

        // ── WebDAV primaire ──────────────────
        Card {
            title: I18n.cfg-webdav;
            InputField { label-text: I18n.cfg-url;      value <=> root.dav-url; }
            InputField { label-text: I18n.cfg-user;     value <=> root.dav-user; }
            InputField { label-text: I18n.cfg-password; value <=> root.dav-pass; is-password: true; }
            HorizontalLayout {
                spacing: 8px; height: 36px;
                ActionBtn { label: I18n.cfg-save;  bg-color: Palette.gold;  text-color: #1a1a1a;    clicked => { root.save-dav(); } }
                ActionBtn { label: "Test";          bg-color: Palette.teal;  text-color: #1a1a1a;    clicked => { root.test-dav(); } }
                ActionBtn { label: I18n.cfg-clear;  bg-color: Palette.card;  text-color: Palette.text2; clicked => { root.clear-dav(); } }
            }
            if dav-status != "" : Text {
                text: dav-status;
                font-size: 13px + Palette.font-offset;
                color: Palette.text2;
                wrap: word-wrap;
            }
        }

        // ── WebDAV secondaire ────────────────
        Card {
            title: "WebDAV 2 (optionnel)";

            Rectangle {
                height: 36px; border-radius: 8px;
                border-width: 1px;
                border-color: dav2-enabled ? Palette.teal : Palette.card-border;
                background: dav2-enabled ? Palette.teal.with-alpha(0.13) : transparent;
                TouchArea { clicked => { root.dav2-enabled = !root.dav2-enabled; } }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    Text {
                        text: dav2-enabled ? "✓ Activé" : "Désactivé";
                        font-size: 14px + Palette.font-offset; font-weight: 600;
                        color: dav2-enabled ? Palette.teal : Palette.text3;
                        horizontal-stretch: 1; vertical-alignment: center;
                    }
                    Text { text: dav2-enabled ? "🟢" : "⚪"; font-size: 16px + Palette.font-offset; vertical-alignment: center; }
                }
            }

            InputField { label-text: I18n.cfg-url;      value <=> root.dav2-url; }
            InputField { label-text: I18n.cfg-user;     value <=> root.dav2-user; }
            InputField { label-text: I18n.cfg-password; value <=> root.dav2-pass; is-password: true; }

            HorizontalLayout {
                spacing: 8px; height: 36px;
                ActionBtn { label: I18n.cfg-save;  bg-color: Palette.gold;  text-color: #1a1a1a;    clicked => { root.save-dav2(); } }
                ActionBtn { label: "Test";          bg-color: Palette.teal;  text-color: #1a1a1a;    clicked => { root.test-dav2(); } }
                ActionBtn { label: I18n.cfg-clear;  bg-color: Palette.card;  text-color: Palette.text2; clicked => { root.clear-dav2(); } }
            }

            if dav2-status != "" : Text {
                text: dav2-status; font-size: 13px + Palette.font-offset;
                color: Palette.text2; wrap: word-wrap;
            }
        }

        // ── Backup ───────────────────────────
        Card {
            title: "Backup";

            Toggle {
                label: "Backup local";
                value <=> root.backup-local;
                changed(v) => { root.set-backup-local(v); }
            }

            Toggle {
                label: "Backup WebDAV";
                value <=> root.backup-webdav;
                changed(v) => { root.set-backup-webdav(v); }
            }

            // Dossier de données
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Dossier de données";
                    font-size: 13px + Palette.font-offset;
                    color: Palette.text2;
                }
                HorizontalLayout {
                    spacing: 6px; height: 34px;
                    Rectangle {
                        horizontal-stretch: 1; height: 34px;
                        border-radius: 6px; border-width: 1px;
                        border-color: Palette.card-border; background: Palette.card;
                        dir-input := TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.data-dir-edit;
                            font-size: 13px + Palette.font-offset;
                            color: Palette.text;
                            vertical-alignment: center;
                        }
                        if dir-input.text == "" && !dir-input.has-focus : Text {
                            x: 8px; y: (parent.height - self.preferred-height) / 2;
                            text: data-dir-display;
                            font-size: 12px + Palette.font-offset;
                            color: Palette.text3;
                        }
                    }
                    ActionBtn {
                        label: I18n.cfg-save; width: 70px;
                        bg-color: Palette.gold; text-color: #1a1a1a;
                        clicked => { root.set-data-dir(dir-input.text); }
                    }
                }
                Text {
                    text: "Backups → " + backup-dir-display;
                    font-size: 11px + Palette.font-offset;
                    color: Palette.text3;
                    wrap: word-wrap;
                }
            }
        }

        // ── Export profil JSON ────────────────
        Card {
            title: I18n.cfg-export;
            Text {
                text: I18n.cfg-export-desc;
                font-size: 12px + Palette.font-offset;
                color: Palette.text3; wrap: word-wrap;
            }
            ActionBtn {
                label: I18n.cfg-export-btn;
                bg-color: Palette.card; text-color: Palette.text;
                clicked => { root.do-export(); }
            }
        }

        // ── Import profil JSON ───────────────
        Card {
            title: I18n.cfg-import;
            Text {
                text: I18n.cfg-import-desc;
                font-size: 12px + Palette.font-offset;
                color: Palette.text3; wrap: word-wrap;
            }
            ActionBtn {
                label: I18n.cfg-import-btn;
                bg-color: Palette.teal; text-color: #1a1a1a;
                clicked => { root.do-import(); }
            }
        }

        // ── Reset ────────────────────────────
        Card {
            title: I18n.cfg-data;
            ActionBtn {
                label: I18n.cfg-reset;
                danger: true;
                clicked => { root.do-reset(); }
            }
        }

        Rectangle { height: 40px; }
    }
}
