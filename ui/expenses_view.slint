// oxycash-rs - ui/expenses_view.slint

import { Palette } from "palette.slint";
import { I18n } from "i18n.slint";

export struct ExpenseLine {
    name:   string,
    m0:  float, m1:  float, m2:  float, m3:  float,
    m4:  float, m5:  float, m6:  float, m7:  float,
    m8:  float, m9:  float, m10: float, m11: float,
    total: float,
}

export struct ExpenseSection {
    label:  string,
    lines:  [ExpenseLine],
    total:  float,
}

component Cell inherits Rectangle {
    in property <string> txt;
    in property <color>  cell-color: Palette.text;
    in property <bool>   bold: false;
    border-width: 1px;
    border-color: Palette.card-border;
    background: transparent;
    Text {
        text: txt;
        font-size: 13px + Palette.font-offset;
        font-weight: bold ? 700 : 400;
        color: cell-color;
        horizontal-alignment: left;
        vertical-alignment: center;
        x: 4px;
        width: parent.width - 8px;
        height: parent.height;
        overflow: elide;
    }
}

component NameCell inherits Rectangle {
    in property <string> txt;
    in property <bool>   bold: false;
    width: 90px;
    border-width: 1px;
    border-color: Palette.card-border;
    background: transparent;
    Text {
        text: txt;
        font-size: 13px + Palette.font-offset;
        font-weight: bold ? 700 : 400;
        color: bold ? Palette.text : Palette.text2;
        horizontal-alignment: left;
        vertical-alignment: center;
        x: 6px;
        width: parent.width - 10px;
        height: parent.height;
        overflow: elide;
    }
}

component ExpenseTable inherits Rectangle {
    in property <ExpenseSection> section;
    in property <color> accent;
    in property <length> available-width: 800px;

    // col-w: fill available space, min 58px
    property <length> col-w: max(58px, (available-width - 90px - 20px) / 13);
    property <length> table-w: 90px + 13 * col-w;
    property <length> row-h: 28px;

    border-radius: 10px;
    background: Palette.card;
    border-width: 1px;
    border-color: Palette.card-border;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 10px;
        spacing: 0px;

        // Section title row (outside scroll)
        HorizontalLayout {
            height: 32px;
            Text {
                text: section.label;
                font-size: 15px + Palette.font-offset;
                font-weight: 700;
                color: Palette.text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: section.total;
                font-size: 14px + Palette.font-offset;
                font-weight: 700;
                color: accent;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 1px; background: Palette.card-border; }

        // Horizontally scrollable table
        Flickable {
            height: 26px + section.lines.length * row-h;
            viewport-width: table-w;
            viewport-height: self.height;
            width: root.width - 20px;

            VerticalLayout {
                spacing: 0px;

                // Header row
                HorizontalLayout {
                    spacing: 0px;
                    height: 26px;
                    NameCell { txt: I18n.exp-name; bold: true; }
                    Cell { txt: "J";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "F";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "M";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "A";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "M";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "J";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "J";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "A";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "S";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "O";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "N";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: "D";  cell-color: Palette.text3; width: col-w; }
                    Cell { txt: I18n.exp-total; cell-color: Palette.text3; width: col-w; bold: true; }
                }

                // Data rows
                for line in section.lines : HorizontalLayout {
                    spacing: 0px;
                    height: row-h;
                    NameCell { txt: line.name; }
                    Cell { txt: line.m0  > 0.0 ? line.m0  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m1  > 0.0 ? line.m1  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m2  > 0.0 ? line.m2  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m3  > 0.0 ? line.m3  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m4  > 0.0 ? line.m4  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m5  > 0.0 ? line.m5  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m6  > 0.0 ? line.m6  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m7  > 0.0 ? line.m7  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m8  > 0.0 ? line.m8  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m9  > 0.0 ? line.m9  : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m10 > 0.0 ? line.m10 : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.m11 > 0.0 ? line.m11 : ""; cell-color: accent; width: col-w; }
                    Cell { txt: line.total > 0.0 ? line.total : ""; cell-color: accent; width: col-w; bold: true; }
                }
            }
        }
    }
}

export component ExpensesView inherits Flickable {
    viewport-width: self.width;
    in property <string>         currency:   "CHF";
    in property <ExpenseSection> fixed:      { label: "",      lines: [], total: 0.0 };
    in property <ExpenseSection> occasional: { label: "", lines: [], total: 0.0 };
    in property <ExpenseSection> withdrawals:{ label: "",lines: [], total: 0.0 };

    viewport-height: 36px + 14px
        + (32px + 1px + 26px + fixed.lines.length * 28px + 24px)
        + 12px + (32px + 1px + 26px + occasional.lines.length * 28px + 24px)
        + 12px + (32px + 1px + 26px + withdrawals.lines.length * 28px + 24px)
        + 40px + 28px;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Text {
            text: I18n.exp-title;
            font-size: 22px + Palette.font-offset;
            font-weight: 700;
            color: Palette.text;
        }

        ExpenseTable { section: fixed;        accent: Palette.blue;  available-width: root.width - 28px; }
        ExpenseTable { section: occasional;   accent: Palette.amber; available-width: root.width - 28px; }
        ExpenseTable { section: withdrawals;  accent: Palette.teal;  available-width: root.width - 28px; }

        Rectangle { height: 40px; }
    }
}
