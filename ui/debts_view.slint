// oxycash-rs - ui/debts_view.slint
// Port of build_dettes_view() in special_views.py — fully editable

import { Palette } from "palette.slint";
import { I18n } from "i18n.slint";
import { I18n } from "i18n.slint";

export struct DebtItem {
    rep: string,
    creditor: string,
    pursuit: string,
    balance: float,
    balance-ok: float,
    status: string,
    date: string,
    idx: int,
    planned: string,
    paid: string,
    left: string,
    level: int,
    amounts: [string],
}

component MonthAmount inherits Rectangle {
    in property <string> label;
    in-out property <string> amount;

    horizontal-stretch: 1;

    VerticalLayout {
        spacing: 2px;
        Text { text: label; font-size: 11px + Palette.font-offset; font-weight: 600; color: Palette.text3; horizontal-alignment: center; }
        Rectangle {
            height: 26px;
            border-radius: 5px;
            border-width: 1px;
            border-color: amount != "" ? Palette.teal : Palette.card-border;
            background: #00000020;
            TextInput {
                text <=> root.amount;
                font-size: 13px + Palette.font-offset;
                color: Palette.teal;
                horizontal-alignment: center;
                input-type: decimal;
                vertical-alignment: center;
            }
        }
    }
}

component HeaderBtn inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 76px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.card-border;
    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: label;
        font-size: 13px + Palette.font-offset;
        font-weight: 600;
        color: Palette.text2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component DebtCard inherits Rectangle {
    in property <DebtItem> debt;
    in property <string>   currency;

    callback update-field(int, string, string);  // idx, field-name, value
    callback delete(int);
    callback commit-field(int, string, string);
    callback add-to-month(int, string, string);
    callback apply-recurrence(int, string, string, int, int);
    in-out property <bool>   rec-open: false;
    in-out property <string> rec-amount: "";
    in-out property <int>    rec-fi: 0;
    in-out property <int>    rec-start: 0;
    in-out property <string> a0: debt.amounts[0]; in-out property <string> a1: debt.amounts[1]; in-out property <string> a2: debt.amounts[2]; in-out property <string> a3: debt.amounts[3];
    in-out property <string> a4: debt.amounts[4]; in-out property <string> a5: debt.amounts[5]; in-out property <string> a6: debt.amounts[6]; in-out property <string> a7: debt.amounts[7];
    in-out property <string> a8: debt.amounts[8]; in-out property <string> a9: debt.amounts[9]; in-out property <string> a10: debt.amounts[10]; in-out property <string> a11: debt.amounts[11];

    border-radius: 10px;
    background: Palette.card;
    border-width: 2px;
    border-color: debt.level == 2 ? Palette.green : (debt.level == 1 ? Palette.amber : Palette.danger);

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        // Row 1: Creditor + delete
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.card-border;
                ti-creditor := TextInput {
                    text: debt.creditor;
                    font-size: 15px + Palette.font-offset;
                    font-weight: 700;
                    color: Palette.text;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    accepted => { root.update-field(debt.idx, "creditor", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "creditor", self.text); } }
                }
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: transparent;
                TouchArea { clicked => { root.delete(debt.idx); } }
                Text {
                    text: "x";
                    font-size: 14px + Palette.font-offset;
                    color: Palette.danger;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Row 2: Rep + Pursuit
        HorizontalLayout {
            spacing: 6px;

            Text { text: I18n.deb-rep; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 28px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.rep;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text2;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "rep", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "rep", self.text); } }
                }
            }

            Text { text: I18n.deb-pursuit; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 18px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.pursuit;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text2;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "pursuit", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "pursuit", self.text); } }
                }
            }
        }

        // Row 3: Balance due + Balance negotiated
        HorizontalLayout {
            spacing: 6px;

            Text { text: I18n.deb-due; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 28px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.balance;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.danger;
                    horizontal-alignment: right;
                    input-type: decimal;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "balance", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "balance", self.text); } }
                }
            }

            Text { text: I18n.deb-neg; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 26px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.balance-ok;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.green;
                    horizontal-alignment: right;
                    input-type: decimal;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "balance-ok", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "balance-ok", self.text); } }
                }
            }
        }

        // Row 4: Status + Date
        HorizontalLayout {
            spacing: 6px;

            Text { text: I18n.deb-status; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 40px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.status;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text2;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "status", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "status", self.text); } }
                }
            }

            Text { text: I18n.deb-date; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 30px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.date;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text3;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "date", self.text); }
                    changed has-focus => { if !self.has-focus { root.commit-field(debt.idx, "date", self.text); } }
                }
            }
        }

        // Row 5: Planned / Paid / Left
        HorizontalLayout {
            spacing: 6px;
            height: 22px;

            Text { text: I18n.deb-planned + " " + debt.planned; font-size: 13px + Palette.font-offset; color: Palette.text2; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: I18n.deb-paid + " " + debt.paid; font-size: 13px + Palette.font-offset; font-weight: 600; color: Palette.teal; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: I18n.deb-left + " " + debt.left; font-size: 13px + Palette.font-offset; font-weight: 600; color: Palette.amber; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        }

        // Row 6: Amount per month
        HorizontalLayout {
            spacing: 4px;
            MonthAmount { label: "JAN"; amount <=> a0; }
            MonthAmount { label: "FEB"; amount <=> a1; }
            MonthAmount { label: "MAR"; amount <=> a2; }
            MonthAmount { label: "APR"; amount <=> a3; }
            MonthAmount { label: "MAI"; amount <=> a4; }
            MonthAmount { label: "JUN"; amount <=> a5; }
        }
        HorizontalLayout {
            spacing: 4px;
            MonthAmount { label: "JUL"; amount <=> a6; }
            MonthAmount { label: "AUG"; amount <=> a7; }
            MonthAmount { label: "SEP"; amount <=> a8; }
            MonthAmount { label: "OCT"; amount <=> a9; }
            MonthAmount { label: "NOV"; amount <=> a10; }
            MonthAmount { label: "DEC"; amount <=> a11; }
        }
        HorizontalLayout {
            spacing: 6px;
            height: 30px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: Palette.teal;
                TouchArea {
                    clicked => {
                        root.add-to-month(debt.idx, ti-creditor.text,
                            a0 + ";" + a1 + ";" + a2 + ";" + a3 + ";" + a4 + ";" + a5 + ";"
                            + a6 + ";" + a7 + ";" + a8 + ";" + a9 + ";" + a10 + ";" + a11);
                    }
                }
                Text { text: I18n.deb-to-month; font-size: 14px + Palette.font-offset; font-weight: 700; color: #1a1a1a; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                width: 110px;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.rec-open ? Palette.blue : Palette.card-border;
                background: root.rec-open ? Palette.blue.with-alpha(0.2) : transparent;
                TouchArea { clicked => { root.rec-open = !root.rec-open; } }
                Text { text: I18n.rec-title; font-size: 13px + Palette.font-offset; font-weight: 600; color: root.rec-open ? Palette.blue : Palette.text2; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if root.rec-open : Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.blue;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text { text: I18n.rec-title; font-size: 15px + Palette.font-offset; font-weight: 700; color: Palette.text; }
                Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Palette.card-border;
                    background: #00000020;
                    TextInput {
                        text <=> root.rec-amount;
                        font-size: 14px + Palette.font-offset;
                        color: Palette.teal;
                        horizontal-alignment: center;
                        input-type: decimal;
                        vertical-alignment: center;
                    }
                    if root.rec-amount == "" : Text {
                        text: I18n.pay-amount;
                        font-size: 13px + Palette.font-offset;
                        color: Palette.text3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text { text: I18n.rec-frequency; font-size: 14px + Palette.font-offset; color: Palette.text2; }
                for lbl[i] in [I18n.rec-every-1, I18n.rec-every-2, I18n.rec-every-3, I18n.rec-every-6, I18n.rec-every-12] : Rectangle {
                    height: 26px;
                    background: transparent;
                    TouchArea { clicked => { root.rec-fi = i; } }
                    HorizontalLayout {
                        spacing: 10px;
                        padding-left: 4px;
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 10px; border-width: 2px;
                            border-color: root.rec-fi == i ? Palette.teal : Palette.text3;
                            if root.rec-fi == i : Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Palette.teal; x: 3px; y: 3px; }
                        }
                        Text { text: lbl; font-size: 15px + Palette.font-offset; color: Palette.text; vertical-alignment: center; }
                    }
                }
                Text { text: I18n.deb-start; font-size: 14px + Palette.font-offset; color: Palette.text2; }
                HorizontalLayout {
                    spacing: 4px;
                    for mn[i] in ["JAN", "FEB", "MAR", "APR", "MAI", "JUN"] : Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: root.rec-start == i ? Palette.teal : Palette.card-border;
                        background: root.rec-start == i ? Palette.teal.with-alpha(0.2) : transparent;
                        TouchArea { clicked => { root.rec-start = i; } }
                        Text { text: mn; font-size: 12px + Palette.font-offset; font-weight: 600; color: root.rec-start == i ? Palette.teal : Palette.text2; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    for mn[i] in ["JUL", "AUG", "SEP", "OCT", "NOV", "DEC"] : Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: root.rec-start == i + 6 ? Palette.teal : Palette.card-border;
                        background: root.rec-start == i + 6 ? Palette.teal.with-alpha(0.2) : transparent;
                        TouchArea { clicked => { root.rec-start = i + 6; } }
                        Text { text: mn; font-size: 12px + Palette.font-offset; font-weight: 600; color: root.rec-start == i + 6 ? Palette.teal : Palette.text2; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1; height: 34px; border-radius: 8px;
                        TouchArea { clicked => { root.rec-open = false; } }
                        Text { text: I18n.rec-cancel; font-size: 14px + Palette.font-offset; color: Palette.text2; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1; height: 34px; border-radius: 8px; background: Palette.blue;
                        TouchArea {
                            clicked => {
                                root.apply-recurrence(debt.idx, ti-creditor.text, root.rec-amount,
                                    [1, 2, 3, 6, 12][root.rec-fi], root.rec-start);
                                root.rec-open = false;
                            }
                        }
                        Text { text: I18n.rec-apply; font-size: 14px + Palette.font-offset; font-weight: 700; color: #1a1a1a; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}

export component DebtsView inherits Flickable {
    content-width: self.width;
    in property <string>     currency:     "CHF";
    in property <string>     total-due:    "0";
    in property <string>     total-neg:    "0";
    in property <int>        settled:      0;
    in property <[DebtItem]> debts:        [];

    callback add-debt();
    callback delete-debt(int);
    callback update-debt-field(int, string, string);  // idx, field, value
    callback commit-debt-field(int, string, string);
    callback add-debt-to-month(int, string, string);
    callback apply-debt-recurrence(int, string, string, int, int);
    callback export-debts();
    callback import-debts();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: I18n.deb-title;
                font-size: 22px + Palette.font-offset;
                font-weight: 700;
                color: Palette.text;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            HeaderBtn { label: I18n.cfg-export; clicked => { root.export-debts(); } }
            HeaderBtn { label: I18n.cfg-import; clicked => { root.import-debts(); } }
        }

        // Summary
        Rectangle {
            border-radius: 10px;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.card-border;
            height: 64px;

            HorizontalLayout {
                padding: 14px;
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: I18n.deb-total-due;       font-size: 14px + Palette.font-offset;  font-weight: 600; color: Palette.text3; }
                    Text { text: total-due + " " + currency; font-size: 18px + Palette.font-offset; font-weight: 700; color: Palette.danger; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: I18n.deb-negotiated;      font-size: 14px + Palette.font-offset;  font-weight: 600; color: Palette.text3; }
                    Text { text: total-neg + " " + currency; font-size: 18px + Palette.font-offset; font-weight: 700; color: Palette.green; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: I18n.deb-settled;         font-size: 14px + Palette.font-offset;  font-weight: 600; color: Palette.text3; }
                    Text { text: settled;            font-size: 18px + Palette.font-offset; font-weight: 700; color: Palette.teal; }
                }
            }
        }

        // Debt list
        for debt in debts : DebtCard {
            debt: debt;
            currency: currency;
            update-field(idx, field, val) => { root.update-debt-field(idx, field, val); }
            commit-field(idx, field, val) => { root.commit-debt-field(idx, field, val); }
            delete(idx) => { root.delete-debt(idx); }
            add-to-month(idx, c, a) => { root.add-debt-to-month(idx, c, a); }
            apply-recurrence(idx, c, a, f, s) => { root.apply-debt-recurrence(idx, c, a, f, s); }
        }

        // Add button
        Rectangle {
            height: 42px;
            border-radius: 10px;
            background: transparent;
            border-width: 1px;
            border-color: Palette.card-border;
            TouchArea { clicked => { root.add-debt(); } }
            Text {
                text: I18n.deb-add;
                font-size: 14px + Palette.font-offset;
                font-weight: 600;
                color: Palette.text3;
                horizontal-alignment: center;
            }
        }

        Rectangle { height: 40px; }
    }
}
