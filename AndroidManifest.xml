<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.promethyxx.oxycash">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />

    <application
        android:label="Oxycash"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false">

        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|density"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="oxycash_lib" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
