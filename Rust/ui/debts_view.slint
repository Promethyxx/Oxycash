// oxycash-rs - ui/debts_view.slint
// Port of build_dettes_view() in special_views.py — fully editable

import { Palette } from "palette.slint";

export struct DebtItem {
    rep: string,
    creditor: string,
    pursuit: string,
    balance: float,
    balance-ok: float,
    status: string,
    date: string,
    idx: int,
}

component DebtCard inherits Rectangle {
    in property <DebtItem> debt;
    in property <string>   currency;

    callback update-field(int, string, string);  // idx, field-name, value
    callback delete(int);

    border-radius: 10px;
    background: Palette.card;
    border-width: 1px;
    border-color: debt.balance-ok >= debt.balance && debt.balance > 0.0 ? Palette.green : Palette.card-border;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        // Row 1: Creditor + delete
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.card-border;
                TextInput {
                    text: debt.creditor;
                    font-size: 15px + Palette.font-offset;
                    font-weight: 700;
                    color: Palette.text;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    accepted => { root.update-field(debt.idx, "creditor", self.text); }
                }
            }

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: transparent;
                TouchArea { clicked => { root.delete(debt.idx); } }
                Text {
                    text: "x";
                    font-size: 14px + Palette.font-offset;
                    color: Palette.danger;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Row 2: Rep + Pursuit
        HorizontalLayout {
            spacing: 6px;

            Text { text: "Rep"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 28px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.rep;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text2;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "rep", self.text); }
                }
            }

            Text { text: "N°"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 18px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.pursuit;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text2;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "pursuit", self.text); }
                }
            }
        }

        // Row 3: Balance due + Balance negotiated
        HorizontalLayout {
            spacing: 6px;

            Text { text: "Due"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 28px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.balance;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.danger;
                    horizontal-alignment: right;
                    input-type: decimal;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "balance", self.text); }
                }
            }

            Text { text: "Neg"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 26px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.balance-ok;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.green;
                    horizontal-alignment: right;
                    input-type: decimal;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "balance-ok", self.text); }
                }
            }
        }

        // Row 4: Status + Date
        HorizontalLayout {
            spacing: 6px;

            Text { text: "Status"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 40px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.status;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text2;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "status", self.text); }
                }
            }

            Text { text: "Date"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; width: 30px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: #00000020;
                TextInput {
                    text: debt.date;
                    font-size: 14px + Palette.font-offset;
                    color: Palette.text3;
                    vertical-alignment: center;
                    accepted => { root.update-field(debt.idx, "date", self.text); }
                }
            }
        }
    }
}

export component DebtsView inherits Flickable {
    viewport-width: self.width;
    in property <string>     currency:     "CHF";
    in property <string>     total-due:    "0";
    in property <string>     total-neg:    "0";
    in property <int>        settled:      0;
    in property <[DebtItem]> debts:        [];

    callback add-debt();
    callback delete-debt(int);
    callback update-debt-field(int, string, string);  // idx, field, value

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Debts";
            font-size: 22px + Palette.font-offset;
            font-weight: 700;
            color: Palette.text;
        }

        // Summary
        Rectangle {
            border-radius: 10px;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.card-border;
            height: 64px;

            HorizontalLayout {
                padding: 14px;
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: "Total due";       font-size: 14px + Palette.font-offset;  font-weight: 600; color: Palette.text3; }
                    Text { text: total-due + " " + currency; font-size: 18px + Palette.font-offset; font-weight: 700; color: Palette.danger; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: "Negotiated";      font-size: 14px + Palette.font-offset;  font-weight: 600; color: Palette.text3; }
                    Text { text: total-neg + " " + currency; font-size: 18px + Palette.font-offset; font-weight: 700; color: Palette.green; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: "Settled";         font-size: 14px + Palette.font-offset;  font-weight: 600; color: Palette.text3; }
                    Text { text: settled;            font-size: 18px + Palette.font-offset; font-weight: 700; color: Palette.teal; }
                }
            }
        }

        // Debt list
        for debt in debts : DebtCard {
            debt: debt;
            currency: currency;
            update-field(idx, field, val) => { root.update-debt-field(idx, field, val); }
            delete(idx) => { root.delete-debt(idx); }
        }

        // Add button
        Rectangle {
            height: 42px;
            border-radius: 10px;
            background: transparent;
            border-width: 1px;
            border-color: Palette.card-border;
            TouchArea { clicked => { root.add-debt(); } }
            Text {
                text: "+ Add debt";
                font-size: 14px + Palette.font-offset;
                font-weight: 600;
                color: Palette.text3;
                horizontal-alignment: center;
            }
        }

        Rectangle { height: 40px; }
    }
}
