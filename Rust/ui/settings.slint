// oxycash-rs - ui/settings.slint
// Full port of build_config_view() from special_views.py

import { Palette } from "palette.slint";

export struct ProfileItem {
    name: string,
    slug: string,
    active: bool,
    idx: int,
}

component Card inherits Rectangle {
    in property <string> title;

    border-radius: 12px;
    background: Palette.card;
    border-width: 1px;
    border-color: Palette.card-border;

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        Text {
            text: title;
            font-size: 14px;
            font-weight: 600;
            color: Palette.text3;
        }

        @children
    }
}

component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <color>  bg-color:    Palette.card;
    in property <color>  text-color:  Palette.text;
    in property <bool>   danger:      false;
    callback clicked;

    height: 36px;
    min-width: 60px;
    border-radius: 8px;
    background: danger ? transparent : bg-color;
    border-width: danger ? 1px : 0px;
    border-color: danger ? Palette.danger : transparent;

    TouchArea { clicked => { root.clicked(); } }
    Text {
        text: label;
        font-size: 14px;
        font-weight: 600;
        color: danger ? Palette.danger : text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component InputField inherits Rectangle {
    in property <string>  label-text;
    in-out property <string> value;
    in property <bool>    is-password: false;
    in-out property <bool> show-password: false;

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: label-text;
            font-size: 14px;
            color: Palette.text2;
        }

        HorizontalLayout {
            spacing: 4px;

            Rectangle {
                horizontal-stretch: 1;
                height: 34px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.card-border;
                background: Palette.card;

                if !is-password || show-password : TextInput {
                    text <=> root.value;
                    font-size: 15px;
                    color: Palette.text;
                    vertical-alignment: center;
                }
                if is-password && !show-password : TextInput {
                    text <=> root.value;
                    font-size: 15px;
                    color: Palette.text;
                    vertical-alignment: center;
                    input-type: password;
                }
            }

            if is-password : Rectangle {
                width: 34px; height: 34px; border-radius: 6px;
                border-width: 1px; border-color: Palette.card-border;
                TouchArea { clicked => { show-password = !show-password; } }
                Text {
                    text: show-password ? "🙈" : "👁";
                    font-size: 16px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
}

export component SettingsView inherits Flickable {
    viewport-width: self.width;

    in property <string> profile-name: "Default";
    in property <string> currency:     "CHF";
    in property <bool>   is-dark:      true;
    in property <string> dav-status:   "";

    // Profiles
    in property <[ProfileItem]> profiles: [];

    // WebDAV fields (two-way)
    in-out property <string> dav-url:  "";
    in-out property <string> dav-user: "";
    in-out property <string> dav-pass: "";

    // Currency field
    in-out property <string> currency-edit: "CHF";

    callback toggle-theme;
    callback save-dav();
    callback test-dav();
    callback clear-dav();
    callback save-currency();
    callback do-export();
    callback do-import();
    callback do-reset();
    callback switch-profile(int);
    callback delete-profile(int);
    callback add-profile(string);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Configuration";
            font-size: 22px;
            font-weight: 700;
            color: Palette.text;
        }

        // ── Profiles ─────────────────────────
        Card {
            title: "Profiles";

            for prof in profiles : Rectangle {
                height: 38px;
                border-radius: 8px;
                background: prof.active ? Palette.card : transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    // Active dot
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: prof.active ? Palette.teal : transparent;
                        border-width: 1px;
                        border-color: Palette.teal;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: prof.name;
                        font-size: 14px;
                        color: Palette.text;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    // Switch button
                    Rectangle {
                        width: 44px;
                        height: 26px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: prof.active ? Palette.teal : Palette.card-border;
                        TouchArea { clicked => { root.switch-profile(prof.idx); } }
                        Text {
                            text: prof.active ? "✓" : "Use";
                            font-size: 14px;
                            color: prof.active ? Palette.teal : Palette.text2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Delete
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        TouchArea { clicked => { root.delete-profile(prof.idx); } }
                        Text {
                            text: "x";
                            font-size: 14px;
                            color: Palette.danger;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Add profile
            HorizontalLayout {
                spacing: 6px;
                height: 36px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.card-border;
                    new-name-input := TextInput {
                        font-size: 14px;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                }

                ActionBtn {
                    label: "+ Add";
                    bg-color: Palette.teal;
                    text-color: #1a1a1a;
                    clicked => {
                        root.add-profile(new-name-input.text);
                        new-name-input.text = "";
                    }
                }
            }
        }

        // ── Currency ─────────────────────────
        Card {
            title: "Currency";

            HorizontalLayout {
                spacing: 8px;
                height: 36px;

                Rectangle {
                    width: 80px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.card-border;
                    TextInput {
                        text <=> root.currency-edit;
                        font-size: 15px;
                        color: Palette.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                ActionBtn {
                    label: "Save";
                    bg-color: Palette.gold;
                    text-color: #1a1a1a;
                    clicked => { root.save-currency(); }
                }
            }
        }

        // ── Theme ────────────────────────────
        Card {
            title: "Theme";

            Rectangle {
                height: 40px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.card-border;
                TouchArea { clicked => { root.toggle-theme(); } }

                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;

                    Text {
                        text: is-dark ? "🌙" : "☀️";
                        font-size: 20px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: is-dark ? "Dark — switch to light" : "Light — switch to dark";
                        font-size: 15px;
                        font-weight: 600;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── WebDAV ───────────────────────────
        Card {
            title: "WebDAV (Nextcloud, kDrive…)";

            InputField { label-text: "WebDAV URL"; value <=> root.dav-url; }
            InputField { label-text: "Username";   value <=> root.dav-user; }
            InputField { label-text: "Password";   value <=> root.dav-pass; is-password: true; }

            HorizontalLayout {
                spacing: 8px;
                height: 36px;

                ActionBtn { label: "Save";  bg-color: Palette.gold; text-color: #1a1a1a; clicked => { root.save-dav(); } }
                ActionBtn { label: "Test";  bg-color: Palette.teal; text-color: #1a1a1a; clicked => { root.test-dav(); } }
                ActionBtn { label: "Clear"; bg-color: Palette.card; text-color: Palette.text2; clicked => { root.clear-dav(); } }
            }

            if dav-status != "" : Text {
                text: dav-status;
                font-size: 14px;
                color: Palette.text2;
            }
        }

        // ── Export ────────────────────────────
        Card {
            title: "Export";

            ActionBtn {
                label: "Export JSON";
                bg-color: Palette.card;
                text-color: Palette.text;
                clicked => { root.do-export(); }
            }

            Text {
                text: "Saved to user folder";
                font-size: 14px;
                color: Palette.text3;
            }
        }

        // ── Import ───────────────────────────
        Card {
            title: "Import";

            Text {
                text: "Import from ~/.oxycash/ folder";
                font-size: 14px;
                color: Palette.text3;
            }

            ActionBtn {
                label: "Import JSON";
                bg-color: Palette.teal;
                text-color: #1a1a1a;
                clicked => { root.do-import(); }
            }
        }

        // ── Reset ────────────────────────────
        Card {
            title: "Data";

            ActionBtn {
                label: "Reset all data";
                danger: true;
                clicked => { root.do-reset(); }
            }
        }

        Rectangle { height: 40px; }
    }
}
