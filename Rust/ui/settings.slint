// oxycash-rs - ui/settings.slint
import { Palette } from "palette.slint";

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 48px;
    border-radius: 8px;
    background: Palette.card;
    border-width: 1px;
    border-color: Palette.card-border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        Text { text: label; font-size: 13px; color: Palette.text2; }
        Text { text: value; font-size: 13px; color: Palette.text; font-weight: 600; }
    }
}

export component SettingsView inherits Flickable {
    in property <string> profile-name: "Default";
    in property <string> currency:     "CHF";
    in property <bool>   is-dark:      true;

    callback toggle-theme;

    viewport-height: 400px;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "⚙️ Settings";
            font-size: 16px;
            font-weight: 700;
            color: Palette.text;
        }

        SettingRow { label: "Profil";    value: profile-name; }
        SettingRow { label: "Devise";    value: currency; }
        SettingRow { label: "Theme"; value: is-dark ? "Dark" : "Light"; }

        // Bouton theme toggle
        Rectangle {
            height: 42px;
            border-radius: 10px;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.card-border;
            touch := TouchArea { clicked => { root.toggle-theme(); } }

            Text {
                text: is-dark ? "☀️  Switch to light mode" : "🌙  Switch to dark mode";
                font-size: 13px;
                font-weight: 600;
                color: Palette.teal;
                horizontal-alignment: center;
            }
        }

        // WebDAV config - placeholder, to be extended
        Rectangle {
            height: 80px;
            border-radius: 10px;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.card-border;
            Text {
                text: "WebDAV - configuration to be implemented";
                font-size: 12px;
                color: Palette.text3;
                horizontal-alignment: center;
            }
        }
    }
}
