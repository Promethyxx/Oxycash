// oxycash-rs - ui/savings_view.slint
// Port of build_epargne_view() — savings projects with sub-rows

import { Palette } from "palette.slint";

export struct SavingsRowItem {
    name: string,
    montant: float,
    cible: float,
    percent: int,
    idx: int,
}

export struct SavingsEntry {
    label: string,
    montant: float,
    cible: float,
    percent: int,
    idx: int,
    open: bool,
    rows: [SavingsRowItem],
}

export component SavingsView inherits Flickable {
    viewport-width: self.width;
    in property <string>          currency: "CHF";
    in property <[SavingsEntry]>  entries:  [];

    callback add-project();
    callback delete-project(int);
    callback update-project-field(int, string, string);  // proj-idx, field, value
    callback toggle-project(int);
    callback add-row(int);            // proj-idx
    callback delete-row(int, int);    // proj-idx, row-idx
    callback update-row-field(int, int, string, string);  // proj-idx, row-idx, field, value

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Savings";
            font-size: 22px + Palette.font-offset;
            font-weight: 700;
            color: Palette.text;
        }

        for proj in entries : Rectangle {
            border-radius: 10px;
            background: Palette.card;
            border-width: 1px;
            border-color: proj.open ? Palette.gold : Palette.card-border;

            VerticalLayout {
                padding: 14px;
                spacing: 6px;

                // Project header: label + expand + montant / cible + delete
                HorizontalLayout {
                    spacing: 4px;

                    // Label
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.card-border;
                        TextInput {
                            text: proj.label;
                            font-size: 14px + Palette.font-offset;
                            font-weight: 700;
                            color: Palette.text;
                            vertical-alignment: center;
                            accepted => { root.update-project-field(proj.idx, "label", self.text); }
                        }
                    }

                    // Expand toggle
                    Rectangle {
                        width: 26px; height: 26px; border-radius: 4px;
                        background: proj.open ? Palette.gold.with-alpha(0.2) : transparent;
                        TouchArea { clicked => { root.toggle-project(proj.idx); } }
                        Text {
                            text: proj.open ? "−" : "+";
                            font-size: 16px + Palette.font-offset; font-weight: 700;
                            color: proj.open ? Palette.gold : Palette.text3;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    // Montant
                    Rectangle {
                        width: 82px; height: 30px; border-radius: 6px;
                        border-width: 1px; border-color: Palette.card-border;
                        TextInput {
                            text: proj.montant;
                            font-size: 14px + Palette.font-offset; color: Palette.teal;
                            horizontal-alignment: right; input-type: decimal;
                            vertical-alignment: center;
                            accepted => { root.update-project-field(proj.idx, "montant", self.text); }
                        }
                    }

                    Text { text: "/"; font-size: 15px + Palette.font-offset; font-weight: 700; color: Palette.text3; vertical-alignment: center; }

                    // Cible
                    Rectangle {
                        width: 82px; height: 30px; border-radius: 6px;
                        border-width: 1px; border-color: Palette.card-border;
                        TextInput {
                            text: proj.cible;
                            font-size: 14px + Palette.font-offset; color: Palette.gold;
                            horizontal-alignment: right; input-type: decimal;
                            vertical-alignment: center;
                            accepted => { root.update-project-field(proj.idx, "cible", self.text); }
                        }
                    }

                    // Delete
                    Rectangle {
                        width: 26px; height: 26px; border-radius: 4px;
                        TouchArea { clicked => { root.delete-project(proj.idx); } }
                        Text { text: "x"; font-size: 14px + Palette.font-offset; color: Palette.danger; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Progress bar (project level)
                if proj.cible > 0.0 : VerticalLayout {
                    spacing: 2px;
                    Rectangle {
                        height: 8px; border-radius: 4px; background: Palette.card-border;
                        Rectangle {
                            x: 0px; y: 0px;
                            height: 8px; border-radius: 4px;
                            width: parent.width * proj.percent / 100;
                            background: proj.percent >= 100 ? Palette.green : Palette.teal;
                        }
                    }
                    Text {
                        text: proj.percent + "%";
                        font-size: 14px + Palette.font-offset; font-weight: 700;
                        color: proj.percent >= 100 ? Palette.green : Palette.teal;
                    }
                }

                // Sub-rows (when open)
                if proj.open : VerticalLayout {
                    spacing: 4px;

                    Rectangle { height: 1px; background: Palette.card-border; }

                    for row in proj.rows : Rectangle {
                        border-radius: 8px;
                        background: Palette.card;
                        border-width: 1px;
                        border-color: Palette.card-border;

                        VerticalLayout {
                            padding-left: 12px; padding-right: 12px;
                            padding-top: 8px; padding-bottom: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 4px;

                                // Row name
                                Rectangle {
                                    horizontal-stretch: 1; height: 28px;
                                    border-radius: 5px; border-width: 1px;
                                    border-color: Palette.card-border;
                                    TextInput {
                                        text: row.name;
                                        font-size: 14px + Palette.font-offset; color: Palette.text;
                                        vertical-alignment: center;
                                        accepted => { root.update-row-field(proj.idx, row.idx, "name", self.text); }
                                    }
                                }

                                // Row montant
                                Rectangle {
                                    width: 72px; height: 28px;
                                    border-radius: 5px; border-width: 1px;
                                    border-color: Palette.card-border;
                                    TextInput {
                                        text: row.montant;
                                        font-size: 14px + Palette.font-offset; color: Palette.teal;
                                        horizontal-alignment: right; input-type: decimal;
                                        vertical-alignment: center;
                                        accepted => { root.update-row-field(proj.idx, row.idx, "montant", self.text); }
                                    }
                                }

                                Text { text: "/"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; }

                                // Row cible
                                Rectangle {
                                    width: 72px; height: 28px;
                                    border-radius: 5px; border-width: 1px;
                                    border-color: Palette.card-border;
                                    TextInput {
                                        text: row.cible;
                                        font-size: 14px + Palette.font-offset; color: Palette.gold;
                                        horizontal-alignment: right; input-type: decimal;
                                        vertical-alignment: center;
                                        accepted => { root.update-row-field(proj.idx, row.idx, "cible", self.text); }
                                    }
                                }

                                // Delete row
                                Rectangle {
                                    width: 24px; height: 24px; border-radius: 4px;
                                    TouchArea { clicked => { root.delete-row(proj.idx, row.idx); } }
                                    Text { text: "x"; font-size: 14px + Palette.font-offset; color: Palette.danger; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }

                            // Row progress
                            if row.cible > 0.0 : VerticalLayout {
                                spacing: 2px;
                                Rectangle {
                                    height: 6px; border-radius: 3px; background: Palette.card-border;
                                    Rectangle {
                                        x: 0px; y: 0px;
                                        height: 6px; border-radius: 3px;
                                        width: parent.width * row.percent / 100;
                                        background: row.percent >= 100 ? Palette.green : Palette.teal;
                                    }
                                }
                                Text {
                                    text: row.percent + "%";
                                    font-size: 12px + Palette.font-offset; font-weight: 700;
                                    color: row.percent >= 100 ? Palette.green : Palette.teal;
                                }
                            }
                        }
                    }

                    // Add row button
                    Rectangle {
                        height: 32px; border-radius: 8px;
                        border-width: 1px; border-color: Palette.card-border;
                        TouchArea { clicked => { root.add-row(proj.idx); } }
                        HorizontalLayout {
                            padding-left: 12px; spacing: 6px;
                            Text { text: "+"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; }
                            Text { text: "Add entry"; font-size: 14px + Palette.font-offset; color: Palette.text3; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Add project button
        Rectangle {
            height: 42px; border-radius: 10px;
            border-width: 1px; border-color: Palette.card-border;
            TouchArea { clicked => { root.add-project(); } }
            Text {
                text: "+ New project";
                font-size: 14px + Palette.font-offset; font-weight: 600;
                color: Palette.text3;
                horizontal-alignment: center;
            }
        }

        Rectangle { height: 40px; }
    }
}
