// oxycash-rs - ui/savings_view.slint
// Port of build_epargne_view() — editable sondages

import { Palette } from "palette.slint";

export struct SavingsEntry {
    label: string,
    target: float,
    current: float,
    percent: int,
    idx: int,
}

export component SavingsView inherits Flickable {
    viewport-width: self.width;
    in property <string>          currency: "CHF";
    in property <[SavingsEntry]>  entries:  [];

    callback add-entry();
    callback delete-entry(int);
    callback update-entry-field(int, string, string);  // idx, field, value

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Savings";
            font-size: 20px;
            font-weight: 700;
            color: Palette.text;
        }

        for entry in entries : Rectangle {
            border-radius: 10px;
            background: Palette.card;
            border-width: 1px;
            border-color: entry.percent >= 100 ? Palette.green : Palette.card-border;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                // Name + delete
                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.card-border;
                        TextInput {
                            text: entry.label;
                            font-size: 13px;
                            font-weight: 700;
                            color: Palette.text;
                            vertical-alignment: center;
                            accepted => { root.update-entry-field(entry.idx, "name", self.text); }
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        TouchArea { clicked => { root.delete-entry(entry.idx); } }
                        Text {
                            text: "x";
                            font-size: 12px;
                            color: Palette.danger;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Current + Goal
                HorizontalLayout {
                    spacing: 6px;

                    Text { text: "Current"; font-size: 10px; color: Palette.text3; vertical-alignment: center; width: 50px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.card-border;
                        background: #00000020;
                        TextInput {
                            text: entry.current;
                            font-size: 11px;
                            color: Palette.teal;
                            horizontal-alignment: right;
                            input-type: decimal;
                            vertical-alignment: center;
                            accepted => { root.update-entry-field(entry.idx, "total", self.text); }
                        }
                    }

                    Text { text: "Goal"; font-size: 10px; color: Palette.text3; vertical-alignment: center; width: 32px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 28px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Palette.card-border;
                        background: #00000020;
                        TextInput {
                            text: entry.target;
                            font-size: 11px;
                            color: Palette.gold;
                            horizontal-alignment: right;
                            input-type: decimal;
                            vertical-alignment: center;
                            accepted => { root.update-entry-field(entry.idx, "goal", self.text); }
                        }
                    }
                }

                // Progress bar
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Palette.card-border;

                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        width: clamp(parent.width * entry.percent / 100, 0px, parent.width);
                        background: entry.percent >= 100 ? Palette.green : Palette.teal;
                    }
                }

                Text {
                    text: entry.percent + "%";
                    font-size: 10px;
                    font-weight: 700;
                    color: entry.percent >= 100 ? Palette.green : Palette.teal;
                }
            }
        }

        Rectangle {
            height: 42px;
            border-radius: 10px;
            background: transparent;
            border-width: 1px;
            border-color: Palette.card-border;
            TouchArea { clicked => { root.add-entry(); } }
            Text {
                text: "+ Add project";
                font-size: 12px;
                font-weight: 600;
                color: Palette.text3;
                horizontal-alignment: center;
            }
        }

        Rectangle { height: 40px; }
    }
}
